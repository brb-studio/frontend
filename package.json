{
  "name": "magicstudio",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "audit": "bun audit --audit-level=high",
    "test:e2e": "next build && playwright test"
  },
  "trustedDependencies": [],
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@happy-dom/global-registrator": "20.14.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
