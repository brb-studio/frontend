SITE_URL=http://localhost:3000
# The API (../backend). Called from the Next server only; never exposed to the browser.
BACKEND_URL=http://127.0.0.1:4000
# Optional: pin every request to one tenant (single-tenant installs). Without it the tenant comes from
# the request host, e.g. http://magicstudio.localhost:3000 or http://elite.localhost:3000 in dev.
# TENANT_HOST=magicstudio.localhost
# Shop shown on a host with no tenant in it (localhost, a bare IP). Dev convenience; leave unset in
# production so an unknown host is a 404.
DEFAULT_TENANT_HOST=magicstudio.localhost
# Shared with the API (the same PROXY_SECRET in its .env): lets it trust the visitor IP this server sends.
PROXY_SECRET=
# How many reverse proxies (CDN, load balancer) sit in front of Next. Default 1. The visitor IP is read
# that many entries from the right of X-Forwarded-For, so a forged header can't dodge rate limits.
# TRUSTED_PROXY_HOPS=1
# Stripe publishable key for the card form (public by design; the secret key lives only in the API).
# Outside production only pk_test_ keys are used, and only pk_live_ in production; otherwise card
# payments stay off and customers can still pay by transfer.
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Marketing site (the brb-studio landing) ---
# Hosts that show the landing instead of a barbershop, comma separated (host or host:port). IP
# hosts never match. Dev: http://www.localhost:3000. Production: the apex and www, e.g.
# MARKETING_HOSTS=brbstudio.com,www.brbstudio.com
MARKETING_HOSTS=www.localhost
# Canonical origin of the landing (canonical, hreflang, OG, sitemap). Read at BUILD time: a production
# build with MARKETING_HOSTS set and no MARKETING_URL fails, so dev links never reach production.
MARKETING_URL=http://www.localhost:3000
# The landing is static: these are read at BUILD time (change them → rebuild/redeploy).
# WhatsApp number for "Book a demo", international format, digits only (wa.me link). Unset → email.
# MARKETING_WHATSAPP=5215512345678
# Contact email (fallback CTA and footer). With neither set, the landing shows "contact coming soon".
# MARKETING_EMAIL=hola@example.com
# Optional live sample shop for "See a sample shop" (hidden when unset).
# MARKETING_SHOWCASE_URL=http://montecobre.localhost:3000
