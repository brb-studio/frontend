{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": { "indentStyle": "space" },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "domains": { "next": "recommended", "react": "recommended" }
  },
  "overrides": [
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "../**/app",
                      "../**/app/**",
                      "@/widgets",
                      "@/widgets/**",
                      "../**/widgets",
                      "../**/widgets/**",
                      "@/features",
                      "@/features/**",
                      "../**/features",
                      "../**/features/**",
                      "@/entities",
                      "@/entities/**",
                      "../**/entities",
                      "../**/entities/**"
                    ],
                    "message": "Layers import downward only: app → widgets → features → entities → shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/entities/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "../**/app",
                      "../**/app/**",
                      "@/widgets",
                      "@/widgets/**",
                      "../**/widgets",
                      "../**/widgets/**",
                      "@/features",
                      "@/features/**",
                      "../**/features",
                      "../**/features/**"
                    ],
                    "message": "Layers import downward only: app → widgets → features → entities → shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "../**/app",
                      "../**/app/**",
                      "@/widgets",
                      "@/widgets/**",
                      "../**/widgets",
                      "../**/widgets/**"
                    ],
                    "message": "Layers import downward only: app → widgets → features → entities → shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app", "@/app/**", "../**/app", "../**/app/**"],
                    "message": "Layers import downward only: app → widgets → features → entities → shared."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
